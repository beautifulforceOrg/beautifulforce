# Copy this file to .env.test.local (already gitignored -- see .gitignore's
# ".env.*" rule) and fill in real values. It's loaded ahead of .env.test by
# both `pnpm run test:e2e` and Playwright's own dev-server startup, so
# anything set here overrides .env.test's safe placeholder defaults without
# ever being committed or needing to be pasted into a Claude Code session.
#
# With this in place, `pnpm run test:e2e:razorpay-real` activates
# e2e/razorpay-checkout.spec.ts's real-credential tests -- no manual
# per-run environment variables needed, and Claude can run it itself.
#
# Deliberately NOT included here: E2E_MOCK_EXTERNAL_APIS. The Next dev
# server is one shared process for the whole e2e run, so setting that
# globally to "0" here would flip EVERY test (not just the Razorpay
# ones) into calling the real Razorpay API, breaking every other
# checkout-related test that expects the mocked shortcut. The
# test:e2e:razorpay-real script overrides it inline for just that run
# instead -- see package.json.
#
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys,
# with the Test Mode toggle on (no KYC/business verification needed for
# test-mode keys).

# Real Key ID is not secret (Checkout.js needs it client-side) -- it's
# already set directly in .env.test, so it doesn't need to be repeated
# here. Only the secret needs to stay out of a committed file.
RAZORPAY_KEY_SECRET="<your real Razorpay test-mode Key Secret>"

# Only needed if you want Claude to be able to re-run
# scripts/migrate-images-to-imagekit.ts itself later (e.g. after new
# product photos are added to the catalog import). Get these from
# https://imagekit.io dashboard -> Developer Options. Public key and URL
# endpoint aren't secret, but there's no harm keeping them alongside the
# private key here for one single place to manage local secrets.
IMAGEKIT_PRIVATE_KEY="<your real ImageKit private key>"
IMAGEKIT_PUBLIC_KEY="public_7TV09+n3HWgppUyQg+tQkdbefAo="
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/beautifulforce"

# Lets Claude curl/Playwright-test Vercel Preview deployments directly --
# they're protected by Vercel's Deployment Protection (SSO) by default,
# which blocks unauthenticated requests. Get this from Vercel dashboard
# -> Project -> Settings -> Deployment Protection -> "Protection Bypass
# for Automation". Not wildly sensitive (only bypasses the preview
# wall, no data access on its own), but kept out of committed files
# and chat the same way as everything else here. Usage: send it as the
# x-vercel-protection-bypass header (with x-vercel-set-bypass-cookie:
# true) on the first request, then reuse the _vercel_jwt cookie it sets
# for subsequent requests/a Playwright browser context.
VERCEL_PREVIEW_BYPASS_SECRET="<your real Vercel Protection Bypass secret>"

# Secures the scheduled jobs under app/api/cron/* (see vercel.json) --
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`
# automatically for its own invocations, so nothing else needs to be
# configured beyond setting the same value here and on Vercel. Generate
# any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET="<a random secret string>"

# Real Shiprocket account credentials (same login used for the portal --
# Shiprocket has no separate test-mode API key the way Razorpay does).
# SHIPROCKET_PICKUP_LOCATION must exactly match a pickup address nickname
# already configured in Settings -> Pickup Addresses; Shiprocket rejects
# an order without a valid one. See lib/shipping.ts.
SHIPROCKET_EMAIL="<your real Shiprocket account email>"
SHIPROCKET_PASSWORD="<your real Shiprocket account password>"
SHIPROCKET_PICKUP_LOCATION="<pickup address nickname from the Shiprocket dashboard>"

# Google Maps Places API key for the checkout address form's autocomplete
# (packages/ui's AddressForm). Public/browser-exposed by design -- restrict
# it to this storefront's own domain(s) in the Google Cloud Console rather
# than treating it as a secret. Optional: the form falls back to plain
# text fields if this isn't set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<your real Google Maps API key>"

# The merchant admin dashboard (/admin). Comma-separated, exactly the
# email(s) allowed to log in there -- checked against this list AND a
# matching AdminUser row (see lib/admin/auth.ts). Set this in Vercel's
# real project env vars too, not just here, or the dashboard has no
# admins in production. After setting it, seed each admin's password
# with `ADMIN_SEED_EMAIL=... ADMIN_SEED_PASSWORD=... pnpm run seed:admin`
# (never hardcode a real password anywhere in the repo).
ADMIN_ALLOWED_EMAILS="online.beautifulmess@gmail.com,manishborundia@gmail.com"

# The real, canonical production URL -- used by app/sitemap.ts,
# app/robots.ts, and app/layout.tsx's metadataBase/canonical/Open Graph
# URLs. Falls back to the current Vercel URL if unset (see
# lib/site-config.ts), but MUST be set for real in Vercel once this
# storefront has a custom domain, or sitemap/canonical URLs will keep
# pointing at the Vercel subdomain even after the domain changes.
NEXT_PUBLIC_SITE_URL="https://beautifulforce-beautifulmess.vercel.app"

# Google Search Console site-ownership verification. Leave unset until
# you've started verifying this site in Search Console and it gives you
# an HTML tag verification code (a short string) -- paste just that code
# here (not the whole <meta> tag). Unset means no verification tag is
# rendered at all. See docs/pending-actions.md.
GOOGLE_SITE_VERIFICATION="<paste the code Google Search Console gives you>"

# Sentry error monitoring (docs/pending-actions.md has the one-time
# account-creation step). Leave unset and Sentry stays a complete no-op
# -- nothing sent, no errors, safe by design. Once you have a real
# Sentry project, its setup page gives you these two DSNs (server one is
# NOT public; the NEXT_PUBLIC_ one is meant to be, it's just an ingest
# endpoint, not a secret).
SENTRY_DSN="<your Sentry project's server-side DSN>"
NEXT_PUBLIC_SENTRY_DSN="<your Sentry project's client-side DSN>"
# Only needed if you also want Sentry to upload real source maps at
# build time (nicer stack traces) -- optional, the above two DSNs alone
# already give you working error reporting without this.
SENTRY_ORG="<your Sentry org slug>"
SENTRY_PROJECT="<your Sentry project slug>"
SENTRY_AUTH_TOKEN="<a Sentry auth token, only if uploading source maps>"

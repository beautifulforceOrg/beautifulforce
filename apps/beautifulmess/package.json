{
  "name": "@storeforge/beautifulmess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "postinstall": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.test -- vitest run",
    "db:push": "dotenv -e .env.test -- prisma db push --schema=../../packages/db/prisma/schema.prisma --skip-generate",
    "import:catalog": "dotenv -e .env.test -- tsx scripts/import-shopify-catalog.ts",
    "seed:discounts": "dotenv -e .env.test -- tsx scripts/seed-discounts.ts",
    "seed:admin": "dotenv -e .env.test.local -e .env.test -- tsx scripts/seed-admin-users.ts",
    "seed:homepage-content": "dotenv -e .env.test -- tsx scripts/seed-homepage-content.ts",
    "pretest:e2e": "pnpm run db:push && pnpm run import:catalog && pnpm run seed:discounts && pnpm run seed:homepage-content && ADMIN_SEED_EMAIL=admin-e2e-test@example.com ADMIN_SEED_PASSWORD=\"correct horse battery\" dotenv -e .env.test -- tsx scripts/seed-admin-users.ts && dotenv -e .env.test -- tsx scripts/seed-e2e-admin-customer.ts",
    "test:e2e": "dotenv -e .env.test.local -e .env.test -- playwright test",
    "test:e2e:razorpay-real": "E2E_MOCK_EXTERNAL_APIS=0 dotenv -e .env.test.local -e .env.test -- playwright test e2e/razorpay-checkout.spec.ts",
    "test:e2e:shiprocket-real": "E2E_MOCK_EXTERNAL_APIS=0 dotenv -e .env.test.local -e .env.test -- playwright test e2e/shiprocket-real.spec.ts",
    "test:e2e:preview": "dotenv -e .env.test.local -- playwright test --config=playwright.preview.config.ts"
  },
  "dependencies": {
    "@storeforge/db": "workspace:*",
    "@storeforge/payments": "workspace:*",
    "@storeforge/shipping": "workspace:*",
    "@storeforge/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@storeforge/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^5.6.0",
    "dotenv-cli": "^7.4.4",
    "imagekit": "^6.0.0",
    "imagekit-javascript": "^4.0.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

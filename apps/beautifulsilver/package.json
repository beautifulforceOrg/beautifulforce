{
  "name": "@storeforge/beautifulsilver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "db:push": "dotenv -e .env.test -- prisma db push --schema=../../packages/db/prisma/schema.prisma --skip-generate",
    "seed:catalog": "dotenv -e .env.test -- tsx scripts/seed-catalog.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "pretest:e2e": "pnpm run db:push && pnpm run seed:catalog",
    "test:e2e": "dotenv -e .env.test -- playwright test"
  },
  "dependencies": {
    "@storeforge/db": "workspace:*",
    "@storeforge/payments": "workspace:*",
    "@storeforge/shipping": "workspace:*",
    "@storeforge/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@storeforge/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^7.4.4",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

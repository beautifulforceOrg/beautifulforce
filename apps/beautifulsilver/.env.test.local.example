# Copy to .env.test.local (gitignored) and fill in real values for a real
# deployment of this storefront. Never commit real secrets here -- this
# file only ever holds placeholder text.
#
# Real Razorpay test-mode credentials for this storefront's own Razorpay
# account (never shared with another storefront -- see CLAUDE.md's
# isolation rule). NEXT_PUBLIC_RAZORPAY_KEY_ID is the same value as
# RAZORPAY_KEY_ID, exposed to the browser for Checkout.js
# (app/checkout/page.tsx) -- it's Razorpay's public key, safe to ship
# client-side; RAZORPAY_KEY_SECRET must never be.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# Real Shiprocket credentials for this storefront's own Shiprocket account.
# SHIPROCKET_PICKUP_LOCATION must exactly match a pickup address nickname
# already configured in that account's dashboard (Settings -> Pickup
# Addresses) -- Shiprocket rejects an order without one.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_WEBHOOK_TOKEN=""

# Google Maps Places API key, for the checkout address form's autocomplete
# (packages/ui's AddressForm). Public/browser-exposed by design -- restrict
# it to this storefront's own domain(s) in the Google Cloud Console rather
# than treating it as a secret. Optional: the address form falls back to
# plain text fields if this isn't set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Vercel preview-deployment protection bypass token, if this app's preview
# deployments are password/SSO protected (used only by CI e2e runs against
# a real preview URL, not local dev).
VERCEL_AUTOMATION_BYPASS_SECRET=""

# No ImageKit credentials are needed for this storefront: its seed catalog
# (scripts/seed-catalog.ts) references free stock-photo URLs directly
# rather than re-hosting real product photography.

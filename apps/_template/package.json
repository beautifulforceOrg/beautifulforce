{
  "name": "@storeforge/template-storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "pnpm --filter @storeforge/db run db:push && pnpm --filter @storeforge/db run db:seed",
    "test:e2e": "dotenv -e .env.test -- playwright test"
  },
  "dependencies": {
    "@storeforge/db": "workspace:*",
    "@storeforge/payments": "workspace:*",
    "@storeforge/shipping": "workspace:*",
    "@storeforge/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@storeforge/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^7.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "@storeforge/payments#test": {
      "dependsOn": ["^build", "@storeforge/db#db:push"],
      "outputs": ["coverage/**"]
    },
    "@storeforge/payments#typecheck": {
      "dependsOn": ["^build", "@storeforge/db#db:generate"]
    },
    "@storeforge/shipping#test": {
      "dependsOn": ["^build", "@storeforge/db#db:push"],
      "outputs": ["coverage/**"]
    },
    "@storeforge/shipping#typecheck": {
      "dependsOn": ["^build", "@storeforge/db#db:generate"]
    },
    "@storeforge/template-storefront#typecheck": {
      "dependsOn": ["^build", "@storeforge/db#db:generate"]
    },
    "@storeforge/template-storefront#test:e2e": {
      "dependsOn": ["^build", "@storeforge/db#db:push"],
      "cache": false
    }
  }
}

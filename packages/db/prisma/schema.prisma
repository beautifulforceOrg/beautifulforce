// Storeforge core schema template.
//
// This is not a shared database -- every storefront copies this schema into
// its own isolated Neon instance and extends it with client-specific fields
// or models locally. Changes here that benefit every storefront (a new
// core field, a fixed relation) should still land here first and be
// re-copied outward; one-off client fields belong in that client's own
// copy, never merged back.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (macOS/Linux) and Vercel's build machine;
  // "rhel-openssl-3.0.x" is what Vercel's serverless Lambda runtime
  // actually reports at request time, which differs from the build
  // machine -- without it, the query engine binary generated at build
  // time doesn't match what's needed to run the deployed function.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  description  String? // raw HTML, as most storefront-builder exports (e.g. Shopify's) provide it
  price        Int // smallest currency unit (paise), matches packages/payments pricing helpers
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orderItems   OrderItem[]
  variants     ProductVariant[]
  images       ProductImage[]
  collections  Collection[]     @relation("CollectionToProduct")
  wishlistedBy WishlistItem[]
  reviews      Review[]

  // Identifiers -- today only ProductVariant has a sku, so a single-
  // variant/no-variant product has no SKU at all.
  sku     String? @unique
  barcode String? // UPC/EAN/GTIN
  brand   String?

  // Physical attributes of the product itself.
  weightGrams Int?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?

  // Shipping/package attributes -- used by lib/shipping.ts's
  // createShipmentForOrder instead of a flat per-app guess, so Shiprocket
  // gets a real weight/size for what's actually being shipped.
  packageWeightGrams Int?
  packageLengthCm    Float?
  packageWidthCm     Float?
  packageHeightCm    Float?

  // Pricing depth: `price` stays the real selling price; `mrp` is the
  // strike-through list price shown alongside it (and what marketplaces
  // like Amazon/Flipkart expect as a separate field).
  mrp Int?

  // Compliance -- required to sell online in India under Legal Metrology
  // rules, and required by every marketplace's own listing flow.
  hsnCode             String?
  gstRatePercent      Int?
  countryOfOrigin     String? @default("India")
  // Name + address of manufacturer/packer/importer, kept as one free-text
  // block -- a small single-location business has one, not a table's
  // worth of variation.
  manufacturerDetails String?

  // Merchandising / discovery.
  material         String?
  careInstructions String?
  // Comma-separated search keywords -- simplest shape without a join
  // table; revisit only if faceted search needs real multi-value filters.
  tags             String?

  // Lifecycle: hide from the storefront without deleting the row.
  isPublished       Boolean @default(true)
  // Dashboard flags "running low" once total stockQty across variants
  // drops to or below this.
  lowStockThreshold Int?
}

// A product's purchasable options (size, denomination, ...). Not every
// product has variants -- one with none is sold as itself, matching the
// original single-variant Product shape this extends.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // the option name, e.g. "Size" or "Denomination"
  value      String // the option value, e.g. "5-6 years" or "₹5000"
  sku        String?     @unique
  price      Int? // overrides Product.price when set (a variant-specific price)
  // Null means untracked/unlimited (the default for a storefront that
  // never imports inventory data). 0 means sold out.
  stockQty   Int?
  orderItems OrderItem[]

  @@unique([productId, name, value])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
  altText   String?
}

// A storefront's own catalog grouping (its Shopify collections, a
// boutique's categories, ...) -- deliberately just a name and a product
// list, since anything more specific belongs in that storefront's own app.
model Collection {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[] @relation("CollectionToProduct")
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  // Null for a customer created only as an order's contact (guest
  // checkout, or created by a webhook) -- account features (login,
  // wishlist) all require this to be set.
  passwordHash  String?
  createdAt     DateTime       @default(now())
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  // Set by a mobile app via POST /api/mobile/push-token after the
  // customer logs in and grants notification permission. Nullable/single
  // -- this reference app models one active device per customer, not a
  // per-device token table (Expo re-issues the same token across app
  // restarts on the same device, so re-registering just overwrites it).
  expoPushToken String?
  // A single saved/last-used shipping address, write-through updated from
  // Order.shipTo* every time a logged-in customer places an order (see
  // lib/checkout.ts#placeOrderFor) and used to prefill checkout next time
  // -- not a separate Address table/multi-address book, since nothing else
  // needs more than "the one I used last" yet.
  addressName     String?
  addressPhone    String?
  addressLine1    String?
  addressLine2    String?
  addressCity     String?
  addressState    String?
  addressPincode  String?
}

// A signed-in customer's saved products. Requires an account, unlike the
// cart (which is anonymous/local) -- see apps/beautifulmess/lib/auth.ts
// for the session this is keyed against.
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// A signed-in customer's review of a product. Starts empty for a
// migrated catalog -- the real site's own reviews app (Judge.me, per its
// theme settings) had none recorded for any product either at migration
// time, so this isn't backfilled with invented reviews.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// The footer newsletter form. Not tied to a Customer -- someone can
// subscribe without ever creating an account. Email is unique so a
// re-submission is a harmless no-op, not a duplicate row.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// The Help > Contact page's "Any queries or feedback" form. Stored so a
// submission is never silently lost even before a storefront wires up a
// real transactional email provider to actually notify the merchant --
// see apps/beautifulmess/lib/contact-actions.ts.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  comment   String
  createdAt DateTime  @default(now())
  // Null = unhandled. Set by an admin marking it read/actioned.
  handledAt DateTime?
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id])
  gatewayOrderId     String?     @unique // Razorpay order id -- the webhook idempotency key
  status             OrderStatus @default(PENDING)
  items              OrderItem[]
  // Collected at checkout and handed to packages/shipping's
  // createShipment() once payment is captured -- Shiprocket's API expects
  // a finished address per order, it doesn't collect one itself. Nullable
  // because existing rows predate this field and guest checkout without
  // shipping isn't enforced at the DB layer (the checkout UI requires it).
  shipToName         String?
  shipToEmail        String?
  shipToPhone        String?
  // The Google Places Autocomplete-selected address (street number + route).
  shipToAddressLine1 String?
  // Free text for anything Google's autocomplete doesn't capture -- flat/
  // house/villa number, floor, building name, a landmark -- entered by hand
  // alongside the autocomplete field, not parsed from it.
  shipToAddressLine2 String?
  shipToCity         String?
  shipToState        String?
  shipToPincode      String?
  // Set once createShipment() succeeds -- also doubles as the idempotency
  // guard against creating a second shipment on a redelivered payment
  // webhook (see app/api/webhooks/razorpay/route.ts in each app).
  shipmentId         String?
  awbCode            String?
  courierName        String?
  // Set at order creation by placeOrderFor -- the actual amount charged
  // and any discount applied, in paise. Nullable since pre-existing
  // orders predate these columns. Used by admin revenue analytics
  // instead of re-deriving from current (possibly since-changed) list
  // prices.
  amountPaid         Int?
  discountAmount     Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
}

// A merchant/staff login, kept entirely separate from Customer -- admins
// are never shoppers and must never be reachable through a shopper-facing
// query (e.g. db.customer.findMany() on a marketing page). Who is allowed
// to actually log in is still gated by an ADMIN_ALLOWED_EMAILS allowlist
// checked at login time, independent of whether a row exists here.
model AdminUser {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  // A minimal login-lockout guard -- there is no rate-limiting anywhere
  // else in this codebase, and a small, fixed set of admin accounts is a
  // guessable-password-attempt surface without one.
  failedAttempts Int             @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime        @default(now())
  tickets        Ticket[]
  ticketComments TicketComment[]
}

// Replaces the hardcoded single-entry map that used to live in
// apps/beautifulmess/lib/discount.ts.
model DiscountCode {
  id         String   @id @default(cuid())
  code       String   @unique // stored uppercase-normalized
  percentOff Int // whole percent, 1-100
  active     Boolean  @default(true) // soft-deactivate rather than delete
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum TicketCategory {
  BUG
  FEATURE
  CHANGE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// A lightweight support/request queue so a non-technical store owner can
// file bug/feature/change requests from inside the admin dashboard
// instead of over chat. Both admins are peers here -- no separate
// "developer" role; either can file, comment, or change status.
model Ticket {
  id          String          @id @default(cuid())
  subject     String
  description String
  category    TicketCategory  @default(OTHER)
  status      TicketStatus    @default(OPEN)
  createdById String
  createdBy   AdminUser       @relation(fields: [createdById], references: [id])
  comments    TicketComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TicketComment {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    AdminUser @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())
}
